    "test:e2e:checkout": "vitest run --config vitest.e2e.config.ts e2e/checkout",
    "test:e2e:courier": "vitest run --config vitest.e2e.config.ts e2e/courier",
    "test:e2e:favorites": "vitest run --config vitest.e2e.config.ts e2e/favorites",
    "test:e2e:messages": "vitest run --config vitest.e2e.config.ts e2e/messages",
    "test:e2e:profile": "vitest run --config vitest.e2e.config.ts e2e/profile/profile-management.e2e.test.ts",
    "test:all": "npm run test && npm run test:e2e",
    "commitlint": "commitlint",
    "stripe:listen": "cd .. && stripe listen --forward-to localhost:3000/api/webhook",
    "stripe:trigger": "stripe trigger checkout.session.completed"
  },
